{
  "model": "claude-opus-5-5",
  "permissions": {
    "additionalDirectories": [
      "../src",
      "../docs",
      "../tools"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo [App]"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/../.claude/hooks/desk_activity.py\" app",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/../.claude/hooks/desk_activity.py\" app",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/../.claude/hooks/desk_activity.py\" app",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/../.claude/hooks/desk_activity.py\" app",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
