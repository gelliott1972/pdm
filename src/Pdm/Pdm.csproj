<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Extensions.CognitoAuthentication" Version="3.1.5" />
    <PackageReference Include="AWSSDK.CognitoIdentity" Version="4.0.100.20" />
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="4.0.106.5" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.109.1" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="pdm.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>