<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- PDM Desk: Grant's local page for tickets and session status. Separate from the engineers' PDM app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PdmDesk</AssemblyName>
    <RootNamespace>Desk</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="page\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="page\review.html" LogicalName="review.html" />
    <Content Remove="page\**" />
    <!-- The settings template: install.ps1 copies it to settings.json beside the exe only if that file is missing. -->
    <Content Remove="settings.default.json" />
    <!-- Answer notices: each session runs this with Monitor to be told when Grant answers its tickets. -->
    <None Update="desk-notices.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The sessions' SessionStart and UserPromptSubmit hook: start the notice watch, and say when it has lapsed. -->
    <None Update="desk_notices_hook.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
